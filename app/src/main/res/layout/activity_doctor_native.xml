<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_main">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@color/white">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/desk_brand" android:textColor="@color/wine_primary" android:textSize="12sp"/>
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
  <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone"/>
 <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/wine_primary" android:background="@color/pink_light" android:visibility="gone"/>
 <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="17dp" android:orientation="vertical"/>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:padding="6dp" android:background="@color/white" android:elevation="8dp">
 <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:drawableTop="@drawable/ic_reception_home" android:drawablePadding="4dp" android:text="@string/nav_inicio" android:textSize="11sp" android:textColor="@color/wine_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/navRequests" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:drawableTop="@drawable/ic_reception_calendar" android:drawablePadding="4dp" android:text="@string/desk_agenda_short" android:textSize="11sp" android:textColor="@color/wine_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/navAgenda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:drawableTop="@drawable/ic_reception_requests" android:drawablePadding="4dp" android:text="@string/nav_doctor_consult" android:textSize="11sp" android:textColor="@color/wine_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/navWalkin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:drawableTop="@drawable/ic_reception_patient" android:drawablePadding="4dp" android:text="@string/nav_doctor_records" android:textSize="11sp" android:textColor="@color/wine_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:drawableTop="@drawable/ic_reception_more" android:drawablePadding="4dp" android:text="@string/desk_more_short" android:textSize="11sp" android:textColor="@color/wine_primary" android:clickable="true" android:focusable="true"/>
 </LinearLayout>
</LinearLayout>